# ============================================
# My Vocabulary Builder - Git Ignore
# ============================================

# .NET build output
**/bin/
**/obj/
**/out/
**/artifacts/
[Dd]ebug/
[Rr]elease/
*.binlog
*.lscache

# Publish output / deployment scratch folders
# Ignore any folder whose name begins with publish, anywhere in the repo.
**/publish/
**/publish*/
**/Archive/

# Visual Studio / VS Code / Rider
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates

# NuGet
**/packages/
*.nupkg
*.snupkg
.nuget/

# Angular / Node
**/node_modules/
**/dist/
**/dist-*/
.angular/
out-tsc/
coverage/
.nyc_output/
.npm/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Local secrets / environment-specific configuration
secrets.json
appsettings.Development.user.json
.env
.env.local
.env.*.local
*.pfx
*.publishsettings
SmarterASP.NET Password.txt

# Visual Studio / Azure publish profiles
*.pubxml
*.publish.xml
*.publishproj
*.azurePubxml

# Local databases
*.mdf
*.ldf
*.ndf

# Logs and temporary files
*.log
*.tmp
*.cache
~$*
*~

# OS-generated files
.DS_Store
Thumbs.db

# Python/tool caches (if created locally)
__pycache__/
*.pyc
Docs/R2-Password-Hashing-Analysis.md
Docs/R2-Password-Hashing-Implementation-Plan.md
